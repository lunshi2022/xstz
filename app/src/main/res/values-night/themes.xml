<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Xstz" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/xstz_window_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <style name="Theme.Xstz.Splash" parent="Theme.Xstz">
        <item name="android:windowSplashScreenBackground">@color/xstz_window_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenAnimationDuration">280</item>
    </style>
</resources>
